{
    "name": "flawe/flare-bundle",
    "description": "Send Symfony errors to Flare",
    "license": "MIT",
    "type": "symfony-bundle",
    "authors": [
        {
            "name": "François Lavaud-Wernert",
            "email": "francois@lavaud.family"
        }
    ],
    "require": {
        "php": ">=8.3",
        "spatie/flare-client-php": "^3.0",
        "symfony/config": "^7.0 || ^8.0",
        "symfony/dependency-injection": "^7.0 || ^8.0",
        "symfony/http-foundation": "^7.0 || ^8.0",
        "symfony/http-kernel": "^7.0 || ^8.0"
    },
    "require-dev": {
        "ergebnis/composer-normalize": "^2.51",
        "friendsofphp/php-cs-fixer": "^3.94",
        "phpstan/phpstan": "^2.1",
        "symfony/console": "^7.0 || ^8.0"
    },
    "suggest": {
        "symfony/console": "Report errors raised by console commands",
        "symfony/messenger": "Trace Messenger jobs and queued messages",
        "symfony/monolog-bundle": "Send application logs to Flare"
    },
    "autoload": {
        "psr-4": {
            "Flawe\\FlareBundle\\": "src/"
        }
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true
        }
    },
    "extra": {
        "symfony": {
            "allow-contrib": "true"
        }
    },
    "scripts": {
        "analyse": "phpstan analyse -c ./phpstan.neon",
        "check": "php-cs-fixer check && composer normalize --dry-run",
        "fix": "php-cs-fixer fix && composer normalize"
    }
}
